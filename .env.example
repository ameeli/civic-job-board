# Postgres connection string (Neon: use the pooled connection string).
DATABASE_URL=
# Random string (16+ characters). Vercel sends it as "Authorization: Bearer <value>" on cron requests.
CRON_SECRET=
# The one Google account allowed to sign in (case does not matter). Empty means nobody can sign in.
ALLOWED_EMAIL=
# Random string (32+ characters) that signs session cookies. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The app's own address, without a trailing slash: http://localhost:3000 locally, https://<project>.vercel.app in production.
BETTER_AUTH_URL=
# Google OAuth client (Google Auth Platform > Clients). See docs/deploy.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Gemini API key (free tier) for the daily check's job tags and summaries. See docs/deploy.md.
# Empty means the check still runs and new jobs wait untagged.
GEMINI_API_KEY=
# Optional model and request pace overrides. See README.md#environment-variables for defaults.
GEMINI_MODEL=
GEMINI_REQUESTS_PER_MINUTE=
