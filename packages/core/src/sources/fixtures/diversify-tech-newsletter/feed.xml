<item>
  <title>Diversify Tech #389</title>
  <description>Connecting underrepresented people in tech to career opportunities</description>
      <enclosure url="https://media.beehiiv.com/cdn-cgi/image/fit=scale-down,format=auto,onerror=redirect,quality=80/uploads/asset/file/adec55af-8dcb-49bc-b7e1-f70cbbb09430/social-media.png" length="165256" type="image/png"/>
