{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The web-standard globals every runtime shares (URL, AbortSignal,
    // setTimeout). Node's types are only for the tests, which read fixture
    // files; eslint.config.mjs keeps Node imports out of the package's code.
    "lib": ["ES2023", "DOM"],
    "types": ["node"]
  },
  "include": ["src"]
}
